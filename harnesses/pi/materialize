#!/usr/bin/env python3
"""Serve Pi's lifecycle and materializer capabilities over JSON-RPC stdio."""
import json
import sys


def response(request, result=None, error=None):
    payload = {"jsonrpc": "2.0", "id": request.get("id")}
    if error is not None:
        payload["error"] = error
    else:
        payload["result"] = result
    return json.dumps(payload, separators=(",", ":"))


def materialize(params):
    root = params["root"]
    extensions = params.get("extensions", {})

    def entries(kind):
        return extensions.get(kind, [])

    def names(kind):
        return [entry["name"] for entry in entries(kind)]

    hooks = """// Generated by Locus. pi loads this extension at session start.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

export default function locusHooks(pi: ExtensionAPI) {
  const hooks = %s;
  pi.on("session_start", () => {
    void hooks;
  });
}
""" % json.dumps(names("hooks"), separators=(",", ", "))
    rules = """// Generated by Locus. pi loads these rule bodies through its extension API.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

const rules = %s;
export default function locusRules(pi: ExtensionAPI) {
  pi.on("before_agent_start", () => ({ systemPrompt: rules.join("\\n\\n") }));
}
""" % json.dumps([entry["body"] for entry in entries("rules")], separators=(",", ", "))

    files = []
    if "hooks" in extensions:
        files.append({"path": root + "/extensions/locus-hooks.ts", "mode": 420, "content": hooks})
    if "rules" in extensions:
        files.append({"path": root + "/extensions/locus-rules.ts", "mode": 420, "content": rules})
    return {"files": files}


def handle(request):
    method = request.get("method")
    params = request.get("params", {})
    if method == "plugin.initialize":
        return {"protocol": "locus.plugin.v1", "capabilities": [
            "harness.session", "harness.launch", "harness.events", "harness.materialize"
        ]}
    if method == "plugin.describe":
        return {
            "protocol": "locus.plugin.v1",
            "kind": "harness",
            "id": "pi",
            "version": "1.0.0",
            "capabilities": [
                "harness.session", "harness.launch", "harness.events", "harness.materialize"
            ],
            "schema_versions": {"plugin": "v1"},
            "permissions": ["model_catalog"],
        }
    if method == "plugin.health":
        return {"ready": True}
    if method == "plugin.shutdown":
        return {"stopped": True}
    if method == "harness.materialize" or method == "materialize":
        return materialize(params)
    return None


for raw in sys.stdin:
    request = json.loads(raw)
    result = handle(request)
    if result is None:
        print(response(request, error={"code": -32601, "message": "method not found"}), flush=True)
    else:
        print(response(request, result=result), flush=True)
    if request.get("method") == "plugin.shutdown":
        break
