#!/usr/bin/env python3
"""Return opencode's generated plugin over the materializer JSON-RPC contract.

opencode loads every JS/TS file in its config `plugins/` directory at startup. A plugin
is an async function returning hook implementations, so Locus hook scripts reach opencode
by being written beside the plugin and shelled out to from it.

Scope is the tool lifecycle, which is what `harnesses/opencode.toml` declares as this
harness's downgrade. opencode also exposes a generic `event` subscription covering
session.* — using it would narrow the downgrade, and that is a registry decision rather
than one this script should make on its own.

Determinism: entries are sorted by name, the generated file references its siblings
relatively, and nothing here reads a clock, a hostname, or the run id.
"""
import json
import sys

request = json.loads(sys.stdin.readline())
params = request["params"]
root = params["root"]
hooks = sorted(params.get("extensions", {}).get("hooks", []), key=lambda entry: entry["name"])


def script_name(name):
    """One flat, collision-free filename per hook, mirroring the `dir` strategy's flattening."""
    return name.replace("/", "-")


plugin = """// Generated by Locus. opencode loads every file in this directory at startup.
// Paths are relative to this file so the tree is byte-identical wherever it is built.
const HOOKS = %s;

export const LocusHooks = async ({ $ }) => {
  const run = async (phase, input) => {
    for (const hook of HOOKS) {
      const script = new URL(`../hooks/${hook}`, import.meta.url).pathname;
      await $`sh ${script} ${phase} ${input?.tool ?? ""}`.nothrow();
    }
  };
  return {
    "tool.execute.before": async (input) => {
      await run("tool_call", input);
    },
    "tool.execute.after": async (input) => {
      await run("tool_result", input);
    },
  };
};
""" % json.dumps([script_name(entry["name"]) for entry in hooks], separators=(",", ", "))

files = [
    {
        "path": f"{root}/hooks/{script_name(entry['name'])}",
        "mode": 0o755,
        "content": entry["body"],
    }
    for entry in hooks
]
files.append({"path": root + "/plugins/locus-hooks.ts", "mode": 0o644, "content": plugin})

print(json.dumps({"jsonrpc": "2.0", "id": request.get("id"), "result": {"files": files}}, separators=(",", ":")))
