# Task 12 — hermes against a real binary, in a container, not on the host.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl jq \
 && rm -rf /var/lib/apt/lists/*
COPY bin/locus-detect /usr/local/bin/locus-detect
RUN chmod +x /usr/local/bin/locus-detect && mkdir -p /locus
ARG HERMES_VERSION=
RUN pip install --no-cache-dir "hermes-agent${HERMES_VERSION}"
RUN locus-detect hermes --version
